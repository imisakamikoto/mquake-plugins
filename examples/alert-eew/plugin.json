{
  "schema": 1,
  "id": "com.example.alert-eew",
  "name": "插件预警示例",
  "version": "1.0.0",
  "author": "Mquake SDK",
  "description": "演示 permissions.alerts 授权：插件 EEW 正常触发预警音/通知/全屏/TTS，插件测站参与阈值音效与震源推算。启用前请确认你希望它真的出声。",
  "capabilities": [
    "events",
    "stations",
    "cards"
  ],
  "permissions": {
    "hosts": [],
    "process": false,
    "alerts": true,
    "sound": false,
    "overlay": false
  },
  "transport": {
    "type": "file",
    "file": "data.json",
    "intervalSeconds": 60
  },
  "settings": [
    {
      "key": "reportNum",
      "label": "报号",
      "type": "number",
      "default": 1,
      "description": "递增会触发更新音；与官方 EEW 共用去重"
    }
  ]
}
